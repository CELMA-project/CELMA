# Build image: BOUT++ 5.2.0 (a release, never the development branch) with
# everything CELMA's build and tests need. Published by .github/workflows/image.yml;
# .github/workflows/test.yml pins the published image by digest.
FROM ubuntu:24.04

ARG BOUT_VERSION=v5.2.0

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get -yqq update && apt-get -yqq install --no-install-recommends \
    build-essential ca-certificates cmake git gfortran ninja-build pkg-config \
    libfftw3-dev libnetcdf-dev libnetcdf-c++4-dev libopenmpi-dev openmpi-bin \
    python3 python3-numpy python3-netcdf4 python3-scipy python3-pip \
    python3-h5py python3-matplotlib \
    && rm -rf /var/lib/apt/lists/*

# Several ranks as root inside a container
ENV OMPI_ALLOW_RUN_AS_ROOT=1 OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1

# The source stays in the image: it holds the input file upgrader
RUN git clone --branch "${BOUT_VERSION}" --depth 1 --recurse-submodules --shallow-submodules \
      https://github.com/boutproject/BOUT-dev.git /opt/BOUT-dev \
    && cmake -S /opt/BOUT-dev -B /tmp/bout-build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/bout \
      -DBOUT_USE_NETCDF=ON -DBOUT_USE_FFTW=ON -DBOUT_USE_PETSC=OFF \
      -DBOUT_USE_SLEPC=OFF -DBOUT_USE_SUNDIALS=OFF -DBOUT_USE_HDF5=OFF \
      -DBOUT_BUILD_EXAMPLES=OFF -DBUILD_SHARED_LIBS=ON \
      -DBOUT_GENERATE_FIELDOPS=OFF \
    && cmake --build /tmp/bout-build && cmake --install /tmp/bout-build \
    && rm -rf /tmp/bout-build

ENV CMAKE_PREFIX_PATH=/opt/bout \
    PATH=/opt/bout/bin:$PATH \
    LD_LIBRARY_PATH=/opt/bout/lib \
    PYTHONPATH=/opt/BOUT-dev/tools/pylib

LABEL org.opencontainers.image.source=https://github.com/CELMA-project/CELMA
LABEL org.opencontainers.image.description="BOUT++ 5.2.0 build environment for CELMA"
